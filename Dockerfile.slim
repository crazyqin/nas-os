# NAS-OS Slim Docker Image
# 精简镜像，减少体积，优化构建缓存
#
# v2.600.0 工部修复：
# - Alpine 升级到 3.21（与其他 Dockerfile 保持一致）
# - 修复配置文件路径（configs/config.yaml → configs/default.yaml）
# - 增加 nasctl 二进制
# - 对齐健康检查配置

# Build stage - 使用多阶段构建减小最终镜像体积
FROM golang:1.26-alpine AS builder

# 安装构建依赖
RUN apk add --no-cache git make gcc musl-dev

WORKDIR /build

# 优化层缓存 - 先复制依赖文件
COPY go.mod go.sum ./
RUN go mod download

# 复制源代码
COPY . .

# 构建精简二进制（nasd + nasctl）
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -X main.version=$(cat VERSION)" \
    -trimpath \
    -o nasd ./cmd/nasd && \
    CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -X main.version=$(cat VERSION)" \
    -trimpath \
    -o nasctl ./cmd/nasctl

# Final stage - 最小基础镜像
FROM alpine:3.21

# 安装运行时依赖（仅必需）
RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    curl \
    && rm -rf /var/cache/apk/*

WORKDIR /app

# 复制二进制文件
COPY --from=builder --chmod=755 /build/nasd /usr/local/bin/nasd
COPY --from=builder --chmod=755 /build/nasctl /usr/local/bin/nasctl

# 复制必要配置（修复路径：configs/default.yaml）
COPY --chmod=644 configs/default.yaml /etc/nas-os/config.yaml

# 创建数据目录
RUN mkdir -p /data /config /var/log/nas-os

# 健康检查（与其他 Dockerfile 保持一致）
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -sf http://localhost:8080/api/v1/system/health || exit 1

# 非root用户运行（安全最佳实践）
RUN addgroup -g 1000 nasos && \
    adduser -u 1000 -G nasos -D nasos && \
    chown -R nasos:nasos /usr/local/bin/nasd /usr/local/bin/nasctl /data /config /var/log/nas-os /etc/nas-os

USER nasos

EXPOSE 8080

VOLUME ["/data", "/config"]

ENTRYPOINT ["nasd"]
CMD ["--config", "/etc/nas-os/config.yaml"]
