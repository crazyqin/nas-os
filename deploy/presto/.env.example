# NAS-OS Presto 高速传输部署配置示例
# 复制此文件为 .env 并根据实际环境修改
#
# 使用方式:
#   cp .env.example .env
#   编辑 .env 文件
#   docker compose -f docker-compose.presto.yml up -d

# ==================== NAS-OS 镜像配置 ====================
NAS_OS_IMAGE=ghcr.io/nas-os/nas-os:latest
CONFIG_PATH=./configs
LOG_PATH=./logs

# ==================== Presto 配置 ====================
# 最大并发传输数
PRESTO_MAX_CONCURRENT=4

# 压缩级别 (0-9)
PRESTO_COMPRESS_LEVEL=6

# 启用 AES 加密
PRESTO_ENCRYPT_AES=true

# 分块大小 (MB)
PRESTO_CHUNK_SIZE_MB=64

# 带宽限制 (MB/s, 0=不限速)
PRESTO_BANDWIDTH_MBPS=0

# ==================== 存储路径 ====================
# 传输源目录
TRANSFER_SRC_PATH=/mnt/transfer/src

# 传输目标目录
TRANSFER_DST_PATH=/mnt/transfer/dst

# Presto 数据目录
PRESTO_DATA_PATH=/var/lib/presto

# ==================== 资源限制 ====================
PRESTO_CPU_LIMIT=4.0
PRESTO_MEMORY_LIMIT=4G
PRESTO_CPU_RESERVATION=1.0
PRESTO_MEMORY_RESERVATION=1G

# ==================== 时区配置 ====================
TZ=Asia/Shanghai

# ==================== 日志配置 ====================
LOG_LEVEL=info

# ==================== Prometheus 配置 ====================
PROMETHEUS_PORT=9091
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=5GB

# ==================== Grafana 配置 ====================
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=presto123

# ==================== Alertmanager 配置 ====================
ALERTMANAGER_PORT=9094

# ==================== SMTP 配置（告警邮件） ====================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=nas-os@example.com
SMTP_USER=nas-os@example.com
SMTP_PASSWORD=changeme

# 告警邮件接收地址
ALERT_EMAIL=admin@example.com
ALERT_EMAIL_CRITICAL=admin@example.com
