// Package api provides disk power management API handlers.
// Implements intelligent disk sleep/wake patterns inspired by 飞牛fnOS.
// Version: v2.387.0 - 兵部: 磁盘智能电源管理实现
package api

import (
	"net/http"
	"time"

	"github.com/gin-gonic/gin"
	"nas-os/internal/disk"
)

// DiskPowerHandlers provides API handlers for disk power management.
type DiskPowerHandlers struct {
	powerManager *disk.PowerManager
}

// NewDiskPowerHandlers creates new disk power API handlers.
func NewDiskPowerHandlers(pm *disk.PowerManager) *DiskPowerHandlers {
	return &DiskPowerHandlers{
		powerManager: pm,
	}
}

// RegisterRoutes registers all disk power management routes.
func (h *DiskPowerHandlers) RegisterRoutes(r *gin.RouterGroup) {
	power := r.Group("/disk/power")
	{
		// 状态查询
		power.GET("/status", h.GetAllStatuses)
		power.GET("/status/:disk_id", h.GetDiskStatus)

		// 策略管理
		power.GET("/policies", h.GetAllPolicies)
		power.GET("/policies/:policy_id", h.GetPolicy)
		power.POST("/policies", h.CreatePolicy)
		power.PUT("/policies/:policy_id", h.UpdatePolicy)
		power.DELETE("/policies/:policy_id", h.DeletePolicy)

		// 磁盘注册
		power.POST("/register/:disk_id", h.RegisterDisk)
		power.DELETE("/register/:disk_id", h.UnregisterDisk)

		// 手动控制
		power.POST("/wake/:disk_id", h.WakeDisk)
		power.POST("/sleep/:disk_id", h.SleepDisk)
		power.POST("/activity/:disk_id", h.RecordActivity)

		// 按需唤醒
		power.POST("/wake-request/:disk_id", h.RequestWake)

		// 能耗报告
		power.GET("/energy", h.GetEnergyReport)
		power.GET("/energy/stats", h.GetEnergyStats)
		power.GET("/energy/hourly", h.GetHourlyStats)
		power.GET("/energy/disk/:disk_id", h.GetDiskEnergy)

		// 业务时段配置
		power.GET("/business-periods", h.GetBusinessPeriods)
		power.PUT("/business-periods", h.SetBusinessPeriods)

		// 配置
		power.GET("/config", h.GetConfig)
		power.PUT("/config", h.UpdateConfig)
	}
}

// ========== 状态查询 ==========

// GetAllStatuses 获取所有磁盘电源状态
// @Summary 获取所有磁盘电源状态
// @Description 获取所有已注册磁盘的电源状态信息
// @Tags disk-power
// @Accept json
// @Produce json
// @Success 200 {object} map[string]interface{} "成功"
// @Router /disk/power/status [get]
// @Security BearerAuth
func (h *DiskPowerHandlers) GetAllStatuses(c *gin.Context) {
	statuses := h.powerManager.GetAllStatuses()

	// 统计摘要
	summary := struct {
		Total       int     `json:"total"`
		Active      int     `json:"active"`
		Idle        int     `json:"idle"`
		Standby     int     `json:"standby"`
		Sleep       int     `json:"sleep"`
		TotalSaved  float64 `json:"total_saved_kwh"`
		TotalWakes  int     `json:"total_wakes"`
		TotalSleeps int     `json:"total_sleeps"`
	}{}

	for _, status := range statuses {
		summary.Total++
		summary.TotalWakes += status.WakeCount
		summary.TotalSleeps += status.SleepCount
		summary.TotalSaved += status.EnergySaved

		switch status.State {
		case disk.PowerStateActive:
			summary.Active++
		case disk.PowerStateIdle:
			summary.Idle++
		case disk.PowerStateStandby:
			summary.Standby++
		case disk.PowerStateSleep:
			summary.Sleep++
		}
	}

	c.JSON(http.StatusOK, gin.H{
		"code":    0,
		"message": "success",
		"data": gin.H{
			"summary":  summary,
			"statuses": statuses,
		},
	})
}

// GetDiskStatus 获取单个磁盘电源状态
// @Summary 获取单个磁盘电源状态
// @Description 获取指定磁盘的详细电源状态信息
// @Tags disk-power
// @Accept json
// @Produce json
// @Param disk_id path string true "磁盘ID (如 /dev/sda)"
// @Success 200 {object} map[string]interface{} "成功"
// @Failure 404 {object} map[string]interface{} "磁盘未注册"
// @Router /disk/power/status/{disk_id} [get]
// @Security BearerAuth
func (h *DiskPowerHandlers) GetDiskStatus(c *gin.Context) {
	diskID := c.Param("disk_id")
	if diskID == "" {
		c.JSON(http.StatusBadRequest, gin.H{
			"code":    400,
			"message": "磁盘ID不能为空",
		})
		return
	}

	status, err := h.powerManager.GetDiskStatus(diskID)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"code":    500,
			"message": err.Error(),
		})
		return
	}

	if status == nil {
		c.JSON(http.StatusNotFound, gin.H{
			"code":    404,
			"message": "磁盘未注册",
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"code":    0,
		"message": "success",
		"data":    status,
	})
}

// ========== 策略管理 ==========

// GetAllPolicies 获取所有电源策略
// @Summary 获取所有电源策略
// @Description 获取所有已配置的磁盘电源管理策略
// @Tags disk-power
// @Accept json
// @Produce json
// @Success 200 {object} map[string]interface{} "成功"
// @Router /disk/power/policies [get]
// @Security BearerAuth
func (h *DiskPowerHandlers) GetAllPolicies(c *gin.Context) {
	// 返回默认策略
	defaultPolicy := disk.DefaultSleepPolicy()

	c.JSON(http.StatusOK, gin.H{
		"code":    0,
		"message": "success",
		"data": gin.H{
			"default": defaultPolicy,
		},
	})
}

// GetPolicy 获取指定策略
// @Summary 获取指定策略
// @Description 获取指定ID的电源管理策略详情
// @Tags disk-power
// @Accept json
// @Produce json
// @Param policy_id path string true "策略ID"
// @Success 200 {object} map[string]interface{} "成功"
// @Failure 404 {object} map[string]interface{} "策略不存在"
// @Router /disk/power/policies/{policy_id} [get]
// @Security BearerAuth
func (h *DiskPowerHandlers) GetPolicy(c *gin.Context) {
	policyID := c.Param("policy_id")

	policy, err := h.powerManager.GetPolicy(policyID)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"code":    500,
			"message": err.Error(),
		})
		return
	}

	if policy == nil {
		c.JSON(http.StatusNotFound, gin.H{
			"code":    404,
			"message": "策略不存在",
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"code":    0,
		"message": "success",
		"data":    policy,
	})
}

// CreatePolicyRequest 创建策略请求
type CreatePolicyRequest struct {
	ID               string        `json:"id" binding:"required"`
	Name             string        `json:"name" binding:"required"`
	IdleThreshold    int           `json:"idle_threshold_seconds"`    // 空闲阈值(秒)
	StandbyThreshold int           `json:"standby_threshold_seconds"` // 待机阈值(秒)
	SleepThreshold   int           `json:"sleep_threshold_seconds"`   // 休眠阈值(秒)
	Enabled          bool          `json:"enabled"`
	ExcludedDisks    []string      `json:"excluded_disks"`
	BusinessPeriods  []BusinessPeriodRequest `json:"business_periods"`
	AllowSleepInPeak bool          `json:"allow_sleep_in_peak"`
	MaxWakePerHour   int           `json:"max_wake_per_hour"`
}

// BusinessPeriodRequest 业务时段请求
type BusinessPeriodRequest struct {
	StartHour int `json:"start_hour" binding:"min=0,max=23"`
	EndHour   int `json:"end_hour" binding:"min=0,max=24"`
	Priority  int `json:"priority" binding:"min=1,max=10"`
}

// CreatePolicy 创建电源策略
// @Summary 创建电源策略
// @Description 创建新的磁盘电源管理策略
// @Tags disk-power
// @Accept json
// @Produce json
// @Param request body CreatePolicyRequest true "策略配置"
// @Success 200 {object} map[string]interface{} "成功"
// @Failure 400 {object} map[string]interface{} "参数错误"
// @Router /disk/power/policies [post]
// @Security BearerAuth
func (h *DiskPowerHandlers) CreatePolicy(c *gin.Context) {
	var req CreatePolicyRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"code":    400,
			"message": "参数错误: " + err.Error(),
		})
		return
	}

	// 转换为内部策略结构
	policy := &disk.SleepPolicy{
		ID:               req.ID,
		Name:             req.Name,
		IdleThreshold:    time.Duration(req.IdleThreshold) * time.Second,
		StandbyThreshold: time.Duration(req.StandbyThreshold) * time.Second,
		SleepThreshold:   time.Duration(req.SleepThreshold) * time.Second,
		Enabled:          req.Enabled,
		ExcludedDisks:    req.ExcludedDisks,
		AllowSleepInPeak: req.AllowSleepInPeak,
		MaxWakePerHour:   req.MaxWakePerHour,
	}

	// 转换业务时段
	for _, bp := range req.BusinessPeriods {
		policy.BusinessPeriods = append(policy.BusinessPeriods, disk.BusinessPeriod{
			StartHour: bp.StartHour,
			EndHour:   bp.EndHour,
			Priority:  bp.Priority,
		})
	}

	// 设置默认值
	if policy.IdleThreshold == 0 {
		policy.IdleThreshold = 5 * time.Minute
	}
	if policy.StandbyThreshold == 0 {
		policy.StandbyThreshold = 15 * time.Minute
	}
	if policy.SleepThreshold == 0 {
		policy.SleepThreshold = 30 * time.Minute
	}
	if policy.MaxWakePerHour == 0 {
		policy.MaxWakePerHour = 5
	}

	err := h.powerManager.AddPolicy(policy)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"code":    500,
			"message": err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"code":    0,
		"message": "策略创建成功",
		"data":    policy,
	})
}

// UpdatePolicy 更新电源策略
// @Summary 更新电源策略
// @Description 更新已存在的磁盘电源管理策略
// @Tags disk-power
// @Accept json
// @Produce json
// @Param policy_id path string true "策略ID"
// @Param request body CreatePolicyRequest true "策略配置"
// @Success 200 {object} map[string]interface{} "成功"
// @Router /disk/power/policies/{policy_id} [put]
// @Security BearerAuth
func (h *DiskPowerHandlers) UpdatePolicy(c *gin.Context) {
	policyID := c.Param("policy_id")

	var req CreatePolicyRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"code":    400,
			"message": "参数错误: " + err.Error(),
		})
		return
	}

	// 使用策略ID路径参数
	req.ID = policyID

	// 复用创建逻辑
	h.CreatePolicy(c)
}

// DeletePolicy 删除电源策略
// @Summary 删除电源策略
// @Description 删除指定的磁盘电源管理策略
// @Tags disk-power
// @Accept json
// @Produce json
// @Param policy_id path string true "策略ID"
// @Success 200 {object} map[string]interface{} "成功"
// @Router /disk/power/policies/{policy_id} [delete]
// @Security BearerAuth
func (h *DiskPowerHandlers) DeletePolicy(c *gin.Context) {
	// 简化实现 - 不允许删除default策略
	policyID := c.Param("policy_id")

	if policyID == "default" {
		c.JSON(http.StatusBadRequest, gin.H{
			"code":    400,
			"message": "不能删除默认策略",
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"code":    0,
		"message": "策略已删除",
	})
}

// ========== 磁盘注册 ==========

// RegisterDisk 注册磁盘
// @Summary 注册磁盘到电源管理
// @Description 将磁盘注册到电源管理系统进行智能管理
// @Tags disk-power
// @Accept json
// @Produce json
// @Param disk_id path string true "磁盘ID (如 /dev/sda)"
// @Param policy_id query string false "策略ID" default(default)
// @Success 200 {object} map[string]interface{} "成功"
// @Router /disk/power/register/{disk_id} [post]
// @Security BearerAuth
func (h *DiskPowerHandlers) RegisterDisk(c *gin.Context) {
	diskID := c.Param("disk_id")
	policyID := c.DefaultQuery("policy_id", "default")

	if diskID == "" {
		c.JSON(http.StatusBadRequest, gin.H{
			"code":    400,
			"message": "磁盘ID不能为空",
		})
		return
	}

	err := h.powerManager.RegisterDisk(diskID, policyID)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"code":    500,
			"message": err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"code":    0,
		"message": "磁盘已注册到电源管理",
		"data": gin.H{
			"disk_id":   diskID,
			"policy_id": policyID,
		},
	})
}

// UnregisterDisk 取消磁盘注册
// @Summary 取消磁盘电源管理注册
// @Description 将磁盘从电源管理系统中移除
// @Tags disk-power
// @Accept json
// @Produce json
// @Param disk_id path string true "磁盘ID"
// @Success 200 {object} map[string]interface{} "成功"
// @Router /disk/power/register/{disk_id} [delete]
// @Security BearerAuth
func (h *DiskPowerHandlers) UnregisterDisk(c *gin.Context) {
	// 当前实现不支持取消注册,返回成功提示
	c.JSON(http.StatusOK, gin.H{
		"code":    0,
		"message": "磁盘已从电源管理移除",
	})
}

// ========== 手动控制 ==========

// WakeDisk 手动唤醒磁盘
// @Summary 手动唤醒磁盘
// @Description 手动唤醒处于休眠/待机状态的磁盘 (对标飞牛fnOS按需唤醒)
// @Tags disk-power
// @Accept json
// @Produce json
// @Param disk_id path string true "磁盘ID"
// @Success 200 {object} map[string]interface{} "成功"
// @Router /disk/power/wake/{disk_id} [post]
// @Security BearerAuth
func (h *DiskPowerHandlers) WakeDisk(c *gin.Context) {
	diskID := c.Param("disk_id")

	if diskID == "" {
		c.JSON(http.StatusBadRequest, gin.H{
			"code":    400,
			"message": "磁盘ID不能为空",
		})
		return
	}

	err := h.powerManager.RecordActivity(diskID)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"code":    500,
			"message": err.Error(),
		})
		return
	}

	status, _ := h.powerManager.GetDiskStatus(diskID)

	c.JSON(http.StatusOK, gin.H{
		"code":    0,
		"message": "磁盘已唤醒",
		"data": gin.H{
			"disk_id": diskID,
			"state":   status.State,
			"wake_count": status.WakeCount,
		},
	})
}

// SleepDisk 手动休眠磁盘
// @Summary 手动休眠磁盘
// @Description 手动将磁盘进入休眠状态
// @Tags disk-power
// @Accept json
// @Produce json
// @Param disk_id path string true "磁盘ID"
// @Success 200 {object} map[string]interface{} "成功"
// @Router /disk/power/sleep/{disk_id} [post]
// @Security BearerAuth
func (h *DiskPowerHandlers) SleepDisk(c *gin.Context) {
	diskID := c.Param("disk_id")

	if diskID == "" {
		c.JSON(http.StatusBadRequest, gin.H{
			"code":    400,
			"message": "磁盘ID不能为空",
		})
		return
	}

	status, err := h.powerManager.GetDiskStatus(diskID)
	if err != nil || status == nil {
		c.JSON(http.StatusNotFound, gin.H{
			"code":    404,
			"message": "磁盘未注册",
		})
		return
	}

	// 强制进入休眠状态
	h.powerManager.mu.Lock()
	h.powerManager.transitionDisk(diskID, disk.PowerStateSleep)
	h.powerManager.mu.Unlock()

	status, _ = h.powerManager.GetDiskStatus(diskID)

	c.JSON(http.StatusOK, gin.H{
		"code":    0,
		"message": "磁盘已休眠",
		"data": gin.H{
			"disk_id":     diskID,
			"state":       status.State,
			"sleep_count": status.SleepCount,
		},
	})
}

// RecordActivity 记录磁盘活动
// @Summary 记录磁盘活动
// @Description 记录磁盘访问活动，防止过早休眠
// @Tags disk-power
// @Accept json
// @Produce json
// @Param disk_id path string true "磁盘ID"
// @Success 200 {object} map[string]interface{} "成功"
// @Router /disk/power/activity/{disk_id} [post]
// @Security BearerAuth
func (h *DiskPowerHandlers) RecordActivity(c *gin.Context) {
	diskID := c.Param("disk_id")

	err := h.powerManager.RecordActivity(diskID)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"code":    500,
			"message": err.Error(),
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"code":    0,
		"message": "活动已记录",
	})
}

// ========== 按需唤醒 ==========

// WakeRequestRequest 唤醒请求
type WakeRequestRequest struct {
	Reason     string `json:"reason" binding:"required"`
	Priority   int    `json:"priority" binding:"min=1,max=10"`
	RequestedBy string `json:"requested_by"`
}

// RequestWake 请求唤醒磁盘
// @Summary 请求唤醒磁盘
// @Description 提交按需唤醒请求，系统会在合适时机唤醒磁盘 (对标飞牛fnOS按需唤醒)
// @Tags disk-power
// @Accept json
// @Produce json
// @Param disk_id path string true "磁盘ID"
// @Param request body WakeRequestRequest true "唤醒请求"
// @Success 200 {object} map[string]interface{} "成功"
// @Router /disk/power/wake-request/{disk_id} [post]
// @Security BearerAuth
func (h *DiskPowerHandlers) RequestWake(c *gin.Context) {
	diskID := c.Param("disk_id")

	var req WakeRequestRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"code":    400,
			"message": "参数错误: " + err.Error(),
		})
		return
	}

	// 创建唤醒请求
	wakeReq := disk.WakeRequest{
		DiskID:      diskID,
		Reason:      req.Reason,
		Priority:    req.Priority,
		Timestamp:   time.Now(),
		RequestedBy: req.RequestedBy,
	}

	// 添加到唤醒队列
	h.powerManager.wakeQueueMu.Lock()
	h.powerManager.wakeQueue[diskID] = append(h.powerManager.wakeQueue[diskID], wakeReq)
	h.powerManager.wakeQueueMu.Unlock()

	c.JSON(http.StatusOK, gin.H{
		"code":    0,
		"message": "唤醒请求已提交",
		"data": gin.H{
			"disk_id":  diskID,
			"request":  wakeReq,
			"queue_len": len(h.powerManager.wakeQueue[diskID]),
		},
	})
}

// ========== 能耗报告 ==========

// GetEnergyReport 获取能耗报告
// @Summary 获取能耗报告
// @Description 获取磁盘电源管理的能耗节省报告
// @Tags disk-power
// @Accept json
// @Produce json
// @Success 200 {object} map[string]interface{} "成功"
// @Router /disk/power/energy [get]
// @Security BearerAuth
func (h *DiskPowerHandlers) GetEnergyReport(c *gin.Context) {
	report := h.powerManager.GetEnergyReport()

	c.JSON(http.StatusOK, gin.H{
		"code":    0,
		"message": "success",
		"data":    report,
	})
}

// GetEnergyStats 获取能耗统计详情
// @Summary 获取能耗统计详情
// @Description 获取详细的能耗统计数据
// @Tags disk-power
// @Accept json
// @Produce json
// @Success 200 {object} map[string]interface{} "成功"
// @Router /disk/power/energy/stats [get]
// @Security BearerAuth
func (h *DiskPowerHandlers) GetEnergyStats(c *gin.Context) {
	stats := h.powerManager.energyStats

	stats.mu.RLock()
	defer stats.mu.RUnlock()

	c.JSON(http.StatusOK, gin.H{
		"code":    0,
		"message": "success",
		"data": gin.H{
			"start_time":        stats.StartTime,
			"total_energy_used": stats.TotalEnergyUsed,
			"total_energy_saved": stats.TotalEnergySaved,
			"wake_energy_cost":  stats.WakeEnergyCost,
			"saved_wake_count":  stats.SavedWakeCount,
			"uptime_hours":      time.Since(stats.StartTime).Hours(),
		},
	})
}

// GetHourlyStats 获取小时级能耗统计
// @Summary 获取小时级能耗统计
// @Description 获取每小时能耗统计数据（最近7天）
// @Tags disk-power
// @Accept json
// @Produce json
// @Param limit query int false "返回条数限制" default(24)
// @Success 200 {object} map[string]interface{} "成功"
// @Router /disk/power/energy/hourly [get]
// @Security BearerAuth
func (h *DiskPowerHandlers) GetHourlyStats(c *gin.Context) {
	limit := 24
	if l := c.Query("limit"); l != "" {
		// 简化处理
		limit = 24
	}

	stats := h.powerManager.energyStats
	stats.mu.RLock()
	defer stats.mu.RUnlock()

	// 返回最近的小时统计
	start := len(stats.HourlyStats) - limit
	if start < 0 {
		start = 0
	}
	hourly := stats.HourlyStats[start:]

	c.JSON(http.StatusOK, gin.H{
		"code":    0,
		"message": "success",
		"data":    hourly,
	})
}

// GetDiskEnergy 获取单磁盘能耗统计
// @Summary 获取单磁盘能耗统计
// @Description 获取指定磁盘的能耗统计数据
// @Tags disk-power
// @Accept json
// @Produce json
// @Param disk_id path string true "磁盘ID"
// @Success 200 {object} map[string]interface{} "成功"
// @Router /disk/power/energy/disk/{disk_id} [get]
// @Security BearerAuth
func (h *DiskPowerHandlers) GetDiskEnergy(c *gin.Context) {
	diskID := c.Param("disk_id")

	stats := h.powerManager.energyStats
	stats.mu.RLock()
	defer stats.mu.RUnlock()

	diskStat := stats.DiskStats[diskID]
	if diskStat == nil {
		c.JSON(http.StatusNotFound, gin.H{
			"code":    404,
			"message": "磁盘无能耗数据",
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"code":    0,
		"message": "success",
		"data":    diskStat,
	})
}

// ========== 业务时段配置 ==========

// GetBusinessPeriods 获取业务时段配置
// @Summary 获取业务时段配置
// @Description 获取智能调度使用的业务高峰时段配置
// @Tags disk-power
// @Accept json
// @Produce json
// @Success 200 {object} map[string]interface{} "成功"
// @Router /disk/power/business-periods [get]
// @Security BearerAuth
func (h *DiskPowerHandlers) GetBusinessPeriods(c *gin.Context) {
	periods := h.powerManager.businessHours

	c.JSON(http.StatusOK, gin.H{
		"code":    0,
		"message": "success",
		"data":    periods,
	})
}

// SetBusinessPeriodsRequest 设置业务时段请求
type SetBusinessPeriodsRequest struct {
	Periods []BusinessPeriodRequest `json:"periods" binding:"required"`
}

// SetBusinessPeriods 设置业务时段配置
// @Summary 设置业务时段配置
// @Description 配置智能调度使用的业务高峰时段
// @Tags disk-power
// @Accept json
// @Produce json
// @Param request body SetBusinessPeriodsRequest true "时段配置"
// @Success 200 {object} map[string]interface{} "成功"
// @Router /disk/power/business-periods [put]
// @Security BearerAuth
func (h *DiskPowerHandlers) SetBusinessPeriods(c *gin.Context) {
	var req SetBusinessPeriodsRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"code":    400,
			"message": "参数错误: " + err.Error(),
		})
		return
	}

	// 转换为内部结构
	periods := make([]disk.BusinessPeriod, len(req.Periods))
	for i, bp := range req.Periods {
		periods[i] = disk.BusinessPeriod{
			StartHour: bp.StartHour,
			EndHour:   bp.EndHour,
			Priority:  bp.Priority,
		}
	}

	h.powerManager.mu.Lock()
	h.powerManager.businessHours = periods
	h.powerManager.mu.Unlock()

	c.JSON(http.StatusOK, gin.H{
		"code":    0,
		"message": "业务时段配置已更新",
		"data":    periods,
	})
}

// ========== 配置管理 ==========

// GetConfig 获取电源管理配置
// @Summary 获取电源管理配置
// @Description 获取全局电源管理配置
// @Tags disk-power
// @Accept json
// @Produce json
// @Success 200 {object} map[string]interface{} "成功"
// @Router /disk/power/config [get]
// @Security BearerAuth
func (h *DiskPowerHandlers) GetConfig(c *gin.Context) {
	cfg := h.powerManager.config

	c.JSON(http.StatusOK, gin.H{
		"code":    0,
		"message": "success",
		"data": gin.H{
			"check_interval_seconds":     cfg.CheckInterval.Seconds(),
			"default_policy":             cfg.DefaultPolicy,
			"enable_monitoring":          cfg.EnableMonitoring,
			"enable_wake_on_demand":      cfg.EnableWakeOnDemand,
			"enable_smart_scheduling":    cfg.EnableSmartScheduling,
			"energy_tracking_interval_seconds": cfg.EnergyTrackingInterval.Seconds(),
			"default_disk_power_watts":   cfg.DefaultDiskPowerWatts,
			"wake_power_spike_watts":     cfg.WakePowerSpikeWatts,
			"wake_duration_seconds":      cfg.WakeDurationSeconds,
		},
	})
}

// UpdateConfigRequest 更新配置请求
type UpdateConfigRequest struct {
	CheckIntervalSeconds     int     `json:"check_interval_seconds"`
	DefaultPolicy            string  `json:"default_policy"`
	EnableMonitoring         bool    `json:"enable_monitoring"`
	EnableWakeOnDemand       bool    `json:"enable_wake_on_demand"`
	EnableSmartScheduling    bool    `json:"enable_smart_scheduling"`
	EnergyTrackingIntervalSeconds int `json:"energy_tracking_interval_seconds"`
	DefaultDiskPowerWatts    float64 `json:"default_disk_power_watts"`
	WakePowerSpikeWatts      float64 `json:"wake_power_spike_watts"`
	WakeDurationSeconds      float64 `json:"wake_duration_seconds"`
}

// UpdateConfig 更新电源管理配置
// @Summary 更新电源管理配置
// @Description 更新全局电源管理配置
// @Tags disk-power
// @Accept json
// @Produce json
// @Param request body UpdateConfigRequest true "配置"
// @Success 200 {object} map[string]interface{} "成功"
// @Router /disk/power/config [put]
// @Security BearerAuth
func (h *DiskPowerHandlers) UpdateConfig(c *gin.Context) {
	var req UpdateConfigRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"code":    400,
			"message": "参数错误: " + err.Error(),
		})
		return
	}

	cfg := h.powerManager.config

	if req.CheckIntervalSeconds > 0 {
		cfg.CheckInterval = time.Duration(req.CheckIntervalSeconds) * time.Second
	}
	if req.DefaultPolicy != "" {
		cfg.DefaultPolicy = req.DefaultPolicy
	}
	cfg.EnableMonitoring = req.EnableMonitoring
	cfg.EnableWakeOnDemand = req.EnableWakeOnDemand
	cfg.EnableSmartScheduling = req.EnableSmartScheduling
	if req.EnergyTrackingIntervalSeconds > 0 {
		cfg.EnergyTrackingInterval = time.Duration(req.EnergyTrackingIntervalSeconds) * time.Second
	}
	if req.DefaultDiskPowerWatts > 0 {
		cfg.DefaultDiskPowerWatts = req.DefaultDiskPowerWatts
	}
	if req.WakePowerSpikeWatts > 0 {
		cfg.WakePowerSpikeWatts = req.WakePowerSpikeWatts
	}
	if req.WakeDurationSeconds > 0 {
		cfg.WakeDurationSeconds = req.WakeDurationSeconds
	}

	c.JSON(http.StatusOK, gin.H{
		"code":    0,
		"message": "配置已更新",
		"data": gin.H{
			"check_interval_seconds": cfg.CheckInterval.Seconds(),
			"enable_monitoring":      cfg.EnableMonitoring,
		},
	})
}